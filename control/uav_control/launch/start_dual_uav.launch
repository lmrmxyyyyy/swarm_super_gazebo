<launch>
    <!-- Dual UAV System Launch Configuration -->
    <!-- This launch file starts both UAV1 and UAV2 systems -->
    
    <!-- Arguments for UAV1 -->
    <arg name="uav1_auto_offboard" default="true" />
    
    <!-- Arguments for UAV2 -->
    <arg name="uav2_auto_offboard" default="true" />

    <!-- livox.launch starts Swarm-LIO2 by default.  Enable this only when
         running the control stack without px4/livox.launch. -->
    <arg name="start_localization" default="false" />
    
    <!-- Start one dual-UAV Swarm-LIO2 localization instance. -->
    <include if="$(arg start_localization)"
             file="$(find swarm_lio)/launch/px4_livox_dual.launch"/>
    
    <!-- Start state machine for UAV1 -->
    <include file="$(find state_machine)/launch/jy_state_machine_sim.launch">
        <arg name="uav_name" value="uav1" />
    </include>
    
    <!-- Start state machine for UAV2 -->
    <include file="$(find state_machine)/launch/jy_state_machine_sim.launch">
        <arg name="uav_name" value="uav2" />
    </include>
    
    <!-- control_real_jy2025.launch already starts both UAV controllers. -->
    <include file="$(find uav_control)/launch/control_real_jy2025.launch">
        <arg name="auto_offboard" value="$(arg uav1_auto_offboard)" />
    </include>

    <!-- jy_real.launch already starts both UAV planners. -->
    <include file="$(find super_planner)/launch/jy_real.launch">
        <arg name="start_x" value="0.0" />
        <arg name="start_y" value="0.0" />
        <arg name="start_z" value="0.0" />
    </include>
    
</launch>

<?xml version="1.0"?>
<launch>
    <arg name="rviz" default="true"/>
    <arg name="configure_px4_vision" default="true"/>
    <!-- livox.launch spawns UAV1 at x=-3 and UAV2 at x=3.  This transform is
         for displaying both independent LIO world frames in one RViz. -->
    <!-- Both LIO frames are rotated +90 deg when their coordinates are
         transformed into Gazebo's inertial frame. Therefore Gazebo's
         (+6, 0) relative displacement is (0, -6) in the LIO frames. -->
    <arg name="uav2_visual_x" default="0.0"/>
    <arg name="uav2_visual_y" default="-6.0"/>
    <arg name="uav2_visual_z" default="0.0"/>

    <!-- Communication topics intentionally remain global.  Both estimators
         exchange state on /quadstate_to_teammate and global extrinsics on
         /global_extrinsic_to_teammate when they share one ROS master. -->
    <node pkg="swarm_lio" type="swarm_lio" name="swarm_lio_uav1" output="screen">
        <rosparam command="load" file="$(find swarm_lio)/config/px4_livox_dual.yaml"/>
        <param name="common/drone_id" type="int" value="1"/>
        <param name="common/lid_topic" type="string" value="/uav1/livox/lidar"/>
        <param name="common/imu_topic" type="string" value="/uav1/livox/imu"/>

        <!-- UAV1 reads only UAV2: UAV2 is at (0, -6, 0) in UAV1's LIO world. -->
        <param name="multiuav/direct_teammate_assignment" type="bool" value="true"/>
        <param name="multiuav/direct_teammate_id" type="int" value="2"/>
        <rosparam param="multiuav/direct_teammate_translation">[0.0, -6.0, 0.0]</rosparam>
        <rosparam param="multiuav/direct_teammate_rotation_deg">[0.0, 0.0, 0.0]</rosparam>

        <!-- Preserve the topic API used by the existing planner/controller. -->
        <remap from="/uav1/lidar_slam/odom" to="/uav1/Odometry"/>
        <remap from="/mavros/vision_pose/pose" to="/uav1/mavros/vision_pose/pose"/>
    </node>

    <!-- Switch PX4 to external-vision fusion only after Swarm-LIO2 has
         produced a stable stream and MAVROS is connected. -->
    <node if="$(arg configure_px4_vision)" pkg="swarm_lio"
          type="px4_vision_fusion.py" name="px4_vision_fusion_uav1" output="screen">
        <param name="mavros_ns" value="/uav1/mavros"/>
        <param name="vision_topic" value="/uav1/mavros/vision_pose/pose"/>
    </node>

    <node if="$(arg configure_px4_vision)" pkg="swarm_lio"
          type="px4_vision_fusion.py" name="px4_vision_fusion_uav2" output="screen">
        <param name="mavros_ns" value="/uav2/mavros"/>
        <param name="vision_topic" value="/uav2/mavros/vision_pose/pose"/>
    </node>

    <node pkg="swarm_lio" type="swarm_lio" name="swarm_lio_uav2" output="screen">
        <rosparam command="load" file="$(find swarm_lio)/config/px4_livox_dual.yaml"/>
        <param name="common/drone_id" type="int" value="2"/>
        <param name="common/lid_topic" type="string" value="/uav2/livox/lidar"/>
        <param name="common/imu_topic" type="string" value="/uav2/livox/imu"/>

        <!-- UAV2 reads only UAV1: inverse relative translation (0, 6, 0). -->
        <param name="multiuav/direct_teammate_assignment" type="bool" value="true"/>
        <param name="multiuav/direct_teammate_id" type="int" value="1"/>
        <rosparam param="multiuav/direct_teammate_translation">[0.0, 6.0, 0.0]</rosparam>
        <rosparam param="multiuav/direct_teammate_rotation_deg">[0.0, 0.0, 0.0]</rosparam>

        <remap from="/uav2/lidar_slam/odom" to="/uav2/Odometry"/>
        <remap from="/mavros/vision_pose/pose" to="/uav2/mavros/vision_pose/pose"/>
    </node>

    <group if="$(arg rviz)">
        <node pkg="tf" type="static_transform_publisher"
              name="swarm_lio_rviz_world_alignment"
              args="$(arg uav2_visual_x) $(arg uav2_visual_y) $(arg uav2_visual_z) 0 0 0 uav1/world uav2/world 100"/>
        <node pkg="rviz" type="rviz" name="swarm_lio_rviz"
              args="-d $(find swarm_lio)/rviz_cfg/px4_livox_dual.rviz" output="screen"/>
    </group>
</launch>

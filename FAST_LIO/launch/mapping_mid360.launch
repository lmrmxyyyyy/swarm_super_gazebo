<launch>
<!-- Launch file for Livox MID360 LiDAR -->

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find fast_lio)/config/mid360.yaml" />

	<param name="feature_extract_enable" type="bool" value="0"/>
	<param name="point_filter_num" type="int" value="1"/>
	<param name="max_iteration" type="int" value="3" />
	<param name="filter_size_surf" type="double" value="0.3" />
	<param name="filter_size_map" type="double" value="0.3" />
	<param name="cube_side_length" type="double" value="1000" />
	<param name="runtime_pos_log_enable" type="bool" value="1" />
		<node pkg="fast_lio" type="fastlio_mapping" name="laserMapping_uav1" output="screen">
			<param name="uav_name" value="uav1" />
			<!-- Remap input topics to namespaced versions -->
			<remap from="/livox/lidar" to="/uav1/livox/lidar" />
			<remap from="/livox/imu" to="/uav1/livox/imu" />
			<!-- Remap output topics to namespaced versions -->
			<remap from="/Odometry" to="/uav1/Odometry" />
			<remap from="/cloud_registered" to="/uav1/cloud_registered" />
			<remap from="/cloud_registered_body" to="/uav1/cloud_registered_body" />
			<remap from="/cloud_effected" to="/uav1/cloud_effected" />
			<remap from="/Laser_map" to="/uav1/Laser_map" />
			<remap from="/path" to="/uav1/path" />
			<remap from="/mavros/vision_pose/pose" to="/uav1/mavros/vision_pose/pose" />
			<!-- Avoid TF conflicts by using namespace -->
			<param name="tf_prefix" value="uav1" />
		</node>

		<node pkg="fast_lio" type="fastlio_mapping" name="laserMapping_uav2" output="screen">
			<param name="uav_name" value="uav2" />
			<!-- Remap input topics to namespaced versions -->
			<remap from="/livox/lidar" to="/uav2/livox/lidar" />
			<remap from="/livox/imu" to="/uav2/livox/imu" />
			<!-- Remap output topics to namespaced versions -->
			<remap from="/Odometry" to="/uav2/Odometry" />
			<remap from="/cloud_registered" to="/uav2/cloud_registered" />
			<remap from="/cloud_registered_body" to="/uav2/cloud_registered_body" />
			<remap from="/cloud_effected" to="/uav2/cloud_effected" />
			<remap from="/Laser_map" to="/uav2/Laser_map" />
			<remap from="/path" to="/uav2/path" />
			<remap from="/mavros/vision_pose/pose" to="/uav2/mavros/vision_pose/pose" />
			<!-- Avoid TF conflicts by using namespace -->
			<param name="tf_prefix" value="uav2" />
		</node>


	<!-- RViz node for visualization -->
	<group if="$(arg rviz)">
		<node launch-prefix="nice" name="rviz" pkg="rviz" type="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
	</group>

</launch>

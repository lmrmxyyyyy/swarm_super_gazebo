<launch>

    <!-- Package name is super_planner: roslaunch super_planner jy_real.launch -->
    <arg name="rviz" default="true" />
    <arg name="start_x" default="0.0" />
    <arg name="start_y" default="0.0" />
    <arg name="start_z" default="1.0" />
    <arg name="uav1_inertial_origin_x" default="-3.0" />
    <arg name="uav1_inertial_origin_y" default="-1.0" />
    <arg name="uav1_inertial_origin_z" default="0.1" />
    <arg name="uav1_local_to_inertial_yaw_deg" default="90.0" />
    <arg name="uav2_inertial_origin_x" default="3.0" />
    <arg name="uav2_inertial_origin_y" default="-1.0" />
    <arg name="uav2_inertial_origin_z" default="0.1" />
    <arg name="uav2_local_to_inertial_yaw_deg" default="90.0" />

    <node pkg="super_planner" name="fsm_node_uav1" type="fsm_node" output="screen" ns="uav1">
<!--     1. use absolute path -->
<!--         <param name="config_path" value="" type="string"></param> -->
<!--     2. use file name in super_planner/config/... -->
        <param name="config_name" value="jy_real.yaml" type="string"></param>
        <param name="uav_name" value="uav1" type="string"></param>
        <param name="start_x" value="$(arg start_x)" type="double"></param>
        <param name="start_y" value="$(arg start_y)" type="double"></param>
        <param name="start_z" value="$(arg start_z)" type="double"></param>
        <param name="swarm_uav_num" value="2" type="int"></param>
        <param name="dynamic_collision_en" value="true" type="bool"></param>
        <param name="dynamic_collision_clearance" value="0.4" type="double"></param>
        <param name="dynamic_collision_stale_time" value="0.5" type="double"></param>
        <param name="dynamic_collision_sample_dt" value="0.2" type="double"></param>
        <!-- /uav1/mpc_pred_traj is published only by the MPC controller. -->
        <param name="publish_mpc_pred_traj" value="false" type="bool"></param>
        <param name="mpc_pred_traj_horizon" value="4.0" type="double"></param>
        <param name="inertial_origin_x" value="$(arg uav1_inertial_origin_x)" type="double"></param>
        <param name="inertial_origin_y" value="$(arg uav1_inertial_origin_y)" type="double"></param>
        <param name="inertial_origin_z" value="$(arg uav1_inertial_origin_z)" type="double"></param>
        <param name="local_to_inertial_yaw_deg" value="$(arg uav1_local_to_inertial_yaw_deg)" type="double"></param>

        <!-- Remap topics to namespace -->
        <remap from="/planning/pos_cmd" to="/uav1/planning/pos_cmd" />
        <remap from="/planning_cmd/poly_traj" to="/uav1/planning_cmd/poly_traj" />
        <remap from="/goal" to="/uav1/goal" />
        <remap from="/Odometry" to="/uav1/Odometry" />
        <remap from="/cloud_registered" to="/uav1/cloud_registered" />
        <remap from="/mavros/local_position/odom" to="/uav1/mavros/local_position/odom" />
        <remap from="/state_machine" to="/uav1/state_machine" />
        <remap from="/stop_super" to="/uav1/stop_super" />
        <remap from="/mpc_trajectory" to="/uav1/mpc_trajectory" />
        <remap from="/rm_mpc_trajectory_vis_path" to="/uav1/rm_mpc_trajectory_vis_path" />
        <remap from="/target_in_obs" to="/uav1/target_in_obs" />
    </node>

    <node pkg="super_planner" name="fsm_node_uav2" type="fsm_node" output="screen" ns="uav2">
        <param name="config_name" value="jy_real.yaml" type="string"></param>
        <param name="uav_name" value="uav2" type="string"></param>
        <param name="start_x" value="$(arg start_x)" type="double"></param>
        <param name="start_y" value="$(arg start_y)" type="double"></param>
        <param name="start_z" value="$(arg start_z)" type="double"></param>
        <param name="swarm_uav_num" value="2" type="int"></param>
        <param name="dynamic_collision_en" value="true" type="bool"></param>
        <param name="dynamic_collision_clearance" value="0.4" type="double"></param>
        <param name="dynamic_collision_stale_time" value="0.5" type="double"></param>
        <param name="dynamic_collision_sample_dt" value="0.2" type="double"></param>
        <!-- /uav2/mpc_pred_traj is published only by the MPC controller. -->
        <param name="publish_mpc_pred_traj" value="false" type="bool"></param>
        <param name="mpc_pred_traj_horizon" value="4.0" type="double"></param>
        <param name="inertial_origin_x" value="$(arg uav2_inertial_origin_x)" type="double"></param>
        <param name="inertial_origin_y" value="$(arg uav2_inertial_origin_y)" type="double"></param>
        <param name="inertial_origin_z" value="$(arg uav2_inertial_origin_z)" type="double"></param>
        <param name="local_to_inertial_yaw_deg" value="$(arg uav2_local_to_inertial_yaw_deg)" type="double"></param>

        <!-- Remap topics to namespace -->
        <remap from="/planning/pos_cmd" to="/uav2/planning/pos_cmd" />
        <remap from="/planning_cmd/poly_traj" to="/uav2/planning_cmd/poly_traj" />
        <remap from="/goal" to="/uav2/goal" />
        <remap from="/Odometry" to="/uav2/Odometry" />
        <remap from="/cloud_registered" to="/uav2/cloud_registered" />
        <remap from="/mavros/local_position/odom" to="/uav2/mavros/local_position/odom" />
        <remap from="/state_machine" to="/uav2/state_machine" />
        <remap from="/stop_super" to="/uav2/stop_super" />
        <remap from="/mpc_trajectory" to="/uav2/mpc_trajectory" />
        <remap from="/rm_mpc_trajectory_vis_path" to="/uav2/rm_mpc_trajectory_vis_path" />
        <remap from="/target_in_obs" to="/uav2/target_in_obs" />
    </node>


    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="top_down"
          args="-d $(find super_planner)/rviz/top_down.rviz" output="log"/>
        <!-- <node pkg="rviz" type="rviz" name="fpv" args="-d $(find perfect_drone_sim)/rviz/fpv.rviz" output="log"/> -->



    <!-- <node name="ipc" pkg="rviz" type="rviz" args="-d $(find ipc)/config/env_robomaster.rviz"/> -->
    <!-- <node name="ipc" pkg="rviz" type="rviz" args="-d /home/fractal/IntelligentUAVChampionshipBase/flm_dev/src/keyboard_pos_ctr/test_mpc_tarj.rviz"/> -->

</launch>
